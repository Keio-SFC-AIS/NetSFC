# Rename this file to .env and fill in the values
# Commented variables are optional.

APITITLE=NetSFC API     # The title of the API
VERSION=1.0.0           # The version of the API
DB_NAME=netsfc.db       # The Database name for the SQLite database
HOST=0.0.0.0            # The host to run the API on
PORT=8080               # The port to run the API on
RUNTIME=DEBUG           # [DEBUG, PRODUCTION] The runtime environment of the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500    # The origins allowed for CORS requests, comma-separated list

# AI Advisor (/api/assistant/chat)
# Choose one of the following: 
AI_PROVIDER=openai      # [openai, grok, gemini, anthropic] The AI provider to use for the AI Advisor
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Grok
# GROK_API_KEY=
# GROK_MODEL=grok-4

# Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Claude Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
